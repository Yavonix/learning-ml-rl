   "source": [
    "# Initiate and Train    \n",
    "model_rnn = RNNClassifier(\n",
    "    vocab_size = len(vocab),\n",
    "    embed_dim  = 128,\n",
    "    hidden_dim = 256,\n",
    "    n_classes  = 2\n",
    ")\n",
    "print(model_rnn)\n",
    "\n",
    "train_rnn = ModelTrainStats(\n",
    "    name=\"Vanilla RNN\",\n",
    "    model=model_rnn\n",
    ")\n",
    "models.add(train_rnn)\n",
    "\n",
    "history_rnn = run_training(train_rnn, train_loader, test_loader)\n",
    "\n",
    "history_rnn"
   ]
