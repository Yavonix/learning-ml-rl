   "source": [
    "first_answer = f\"(1) The final test accuracy was {history_brnn.test_acc[-1]*100:.2f}%.\"\n",
    "display(Markdown(first_answer))\n",
    "\n",
    "plot_lines = {\"lstm_train_loss\": history_lstm.train_loss, \"rnn_train_loss\": history_rnn.train_loss, \"brnn_train_loss\": history_brnn.train_loss}\n",
    "\n",
    "plot = px.line(plot_lines, x=torch.arange(1,6), y=[\"lstm_train_loss\", \"rnn_train_loss\", \"brnn_train_loss\"], labels={\"value\": \"Loss\", \"x\": \"Epoch\"})\n",
    "second_answer = \"(2) See plot below\"\n",
    "display(Markdown(second_answer))\n",
    "\n",
    "third_answer = \"\"\"(3) The BRNN trains faster. The BRNN is architecturally simpler (less complex gating architecture) than the LSTM and therefore may be quicker to converge. For the training set, sentiment classification may largely depend on local lexical cues (\"great\" vs \"horrible\") without any dependence on long-range dependencies meaning the LSTM's extra memory machinery may not provide much early benefit. Bidirectionality can also help because information is processed from both the start and end of the sequence, meaning some sentiment cues have a shorter path to the final representation. The FC layer of the BRNN is also twice the size of the LSTM which may aid convergence.\n",
    "\"\"\"\n",
    "display(Markdown(third_answer))\n",
    "\n",
    "plot.show()"
   ]
  },
