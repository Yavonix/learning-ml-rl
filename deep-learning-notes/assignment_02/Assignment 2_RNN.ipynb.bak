   "source": [
    "# Used to generate graph for the report\n",
    "\n",
    "plot = px.line(plot_lines, x=torch.arange(1,6), y=[\"lstm_train_loss\", \"rnn_train_loss\", \"brnn_train_loss\"], labels={\"value\": \"Loss\", \"x\": \"Epoch\"}, title=\"RNN Learning Rate Comparison\")\n",
    "plot.update_layout(\n",
    "    legend_title_text=\"\",\n",
    "    title_x=0.5,\n",
    "    width=1100,\n",
    "    height=600\n",
    ")\n",
    "plot.show()"
   ]
  }
