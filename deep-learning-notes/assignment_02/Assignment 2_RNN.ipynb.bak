   "source": [
    "## Part 0. Setup & Data Preprocessing\n",
    "\n",
    "All three models share the same data pipeline. Complete this section once; it will be reused in every subsequent part.\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "320dd72e",
   "metadata": {},
   "source": [
    "### 0.1. Load the IMDb Dataset\n",
    "\n",
    "Use the HuggingFace datasets library to load IMDb. The dataset has 25 000 training reviews and 25 000 test reviews, each labeled 0 (negative) or 1 (positive).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "669239b0",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "I rented I AM CURIOUS-YELLOW from my video store because of all the controversy that surrounded it when it was first released in 1967. I also heard that at first it was seized by U.S. customs if it ev\n",
      "Label: 0\n"
     ]
    }
   ],
   "source": [
    "from datasets import load_dataset\n",
    "\n",
    "dataset = load_dataset(\"imdb\")\n",
    "train_data = dataset[\"train\"]\n",
    "test_data  = dataset[\"test\"]\n",
    "\n",
    "# Quick look\n",
    "print(train_data[0][\"text\"][:200])\n",
    "print(\"Label:\", train_data[0][\"label\"])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8b9d0dd3",
   "metadata": {},
   "source": [
    "### 0.2. Tokenisation & Vocabulary\n",
    "\n",
    "Convert raw text into integer token sequences. We keep the vocabulary to the 20 000 most common words and cap each review at 500 tokens."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "897e5d80",
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "from collections import Counter\n",
    "import torch\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torch.nn.utils.rnn import pad_sequence\n",
    "\n",
    "# ── helpers ──────────────────────────────────────────────\n",
    "def tokenize(text):\n",
    "    text = text.lower()\n",
    "    return re.findall(r\"\\b[a-z']+\\b\", text)\n",
    "\n",
    "# Build vocab from training set\n",
    "VOCAB_SIZE = 20_000\n",
    "MAX_LEN    = 500\n",
    "PAD_IDX    = 0\n",
    "UNK_IDX    = 1\n",
    "\n",
    "counter = Counter()\n",
    "for ex in train_data:\n",
    "    counter.update(tokenize(ex[\"text\"]))\n",
    "\n",
    "vocab = {\"<pad>\": PAD_IDX, \"<unk>\": UNK_IDX}\n",
    "vocab.update({w: i+2 for i, (w, _) in\n",
    "              enumerate(counter.most_common(VOCAB_SIZE))})\n",
    "\n",
    "def encode(text):\n",
    "    tokens = tokenize(text)[:MAX_LEN]\n",
    "    return [vocab.get(t, UNK_IDX) for t in tokens]\n",
    "\n",
    "# ── Dataset class ─────────────────────────────────────────\n",
    "class IMDbDataset(Dataset):\n",
    "    def __init__(self, split):\n",
    "        self.samples = [\n",
    "            (\n",
    "                torch.tensor(encode(ex[\"text\"]), dtype=torch.long),\n",
    "                torch.tensor(ex[\"label\"],        dtype=torch.long)\n",
    "            )\n",
    "            for ex in dataset[split]\n",
    "        ]\n",
    "\n",
    "    def __len__(self): return len(self.samples)\n",
    "    def __getitem__(self, i): return self.samples[i]\n",
    "\n",
    "\n",
    "def collate(batch):\n",
    "    texts, labels = zip(*batch)\n",
    "    # Capture true lengths BEFORE padding\n",
    "    lengths = torch.tensor([len(t) for t in texts], dtype=torch.long)\n",
    "    texts = pad_sequence(texts, batch_first=True, padding_value=PAD_IDX)\n",
    "    return texts, torch.stack(labels), lengths  # Return lengths\n",
    "\n",
    "\n",
    "train_loader = DataLoader(IMDbDataset(\"train\"), batch_size=64,\n",
    "                          shuffle=True,  collate_fn=collate)\n",
    "test_loader  = DataLoader(IMDbDataset(\"test\"),  batch_size=64,\n",
    "                          shuffle=False, collate_fn=collate)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5a9e9cdc",
   "metadata": {},
   "source": [
    "***Hint***: PyTorch's pad_sequence automatically pads shorter reviews with zeros so all sequences in a batch have the same length. This is necessary for batched processing."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "3e5d1466",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Helper cell for class definitions that collate model results for final comparison table\n",
    "\n",
    "# Instead of just manually copying and pasting the results into the table in less than 5 minutes I instead spent an hour overengineering this...\n",
    "\n",
    "from IPython.display import Markdown, display\n",
    "import plotly.express as px\n",
    "import plotly.io as pio\n",
    "pio.templates.default = \"simple_white\"\n",
    "from dataclasses import dataclass, field\n",
    "import time\n",
    "\n",
    "@dataclass\n",
    "class TrainHistory:\n",
    "    train_loss: list[float] = field(default_factory=list)\n",
    "    train_acc: list[float] = field(default_factory=list)\n",
    "    test_loss: list[float] = field(default_factory=list)\n",
    "    test_acc: list[float] = field(default_factory=list)\n",
    "\n",
    "    def get_dict(self):\n",
    "        return {\n",
    "            \"train_loss\": self.train_loss,\n",
    "            \"train_acc\": self.train_acc,\n",
    "            \"test_loss\": self.test_loss,\n",
    "            \"test_acc\": self.test_acc\n",
    "        }\n",
    "\n",
    "@dataclass\n",
    "class ModelTrainStats:\n",
    "    name: str\n",
    "    model: torch.nn.Module\n",
    "    avg_epoch_time: float = 0.0\n",
    "    train_stats: TrainHistory = field(default_factory=TrainHistory)\n",
    "\n",
    "    def get_param_count(self):\n",
    "        return sum(p.numel() for p in self.model.parameters() if p.requires_grad)\n",
    "    \n",
    "    # torch.cuda.synchronise needed since pytorch runs gpu operations asynchronously\n",
    "    def start_timer(self):\n",
    "        if torch.cuda.is_available():\n",
    "            torch.cuda.synchronize()\n",
    "        self.start_time = time.perf_counter()\n",
    "    \n",
    "    def stop_timer(self, epochs_passed=5):\n",
    "        if torch.cuda.is_available():\n",
    "            torch.cuda.synchronize()\n",
    "\n",
    "        self.avg_epoch_time = (time.perf_counter() - self.start_time) / epochs_passed\n",
    "\n",
    "class ModelTrainCollection:\n",
    "    def __init__(self):\n",
    "        self.tracked: dict[str, ModelTrainStats] = {}\n",
    "    \n",
    "    def add(self, model_train: ModelTrainStats):\n",
    "        self.tracked[model_train.name] = model_train\n",
    "\n",
    "    def __iter__(self):\n",
    "        return iter(self.tracked.values())\n",
    "\n",
    "models = ModelTrainCollection()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a579cb23",
   "metadata": {},
   "source": [
    "## PART 1. Vanilla RNN Sentiment Classifier\n",
    "\n",
    "A vanilla RNN processes text one token at a time, left to right, maintaining a hidden state that acts as its \"memory\". Implement the model below and complete the training loop."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a9f0706f",
   "metadata": {},
   "source": [
    "The model architecture has three stages: Embed → Recur → Classify."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cb09735d",
   "metadata": {},
   "source": [
    "### TASK 1.1. DEFINE BASIC RNN MODEL and TRAINING LOOP\n",
    "\n",
    "Complete the function train_model(model, loader, optimizer, criterion, device) \n",
    "that iterates over one epoch and returns the average loss and accuracy. \n",
    "Then write a corresponding evaluate_model function for the test set (no gradient computation needed).\n",
    "\n",
    "***REQUIREMENTS***\n",
    "\n",
    "Use torch.optim.Adam  with lr=1e-3\n",
    "\n",
    "Use nn.CrossEntropyLoss\n",
    "\n",
    "Train for 5 epochs and print loss & accuracy each epoch\n",
    "\n",
    "Move model and data to device (use GPU if available)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "b6f03a81",
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "torch.manual_seed(42)\n",
    "\n",
    "class RNNClassifier(nn.Module):\n",
    "    def __init__(self, vocab_size, embed_dim, hidden_dim, n_classes, dropout=0.5):\n",
    "        super().__init__()\n",
    "        \"\"\" Your Code\"\"\"\n",
    "        self.embedding = nn.Embedding(vocab_size, embed_dim)\n",
    "        self.rnn = nn.RNN(embed_dim, hidden_dim, batch_first=True, dropout=dropout)\n",
    "        self.fc = nn.Linear(in_features=hidden_dim, out_features=n_classes)\n",
    "\n",
    "    # def forward(self, x):\n",
    "    def forward(self, x, lengths): # had to modify forward pass so that lengths can be used to extract the correct final hidden state\n",
    "        \"\"\" Your Code\"\"\"\n",
    "\n",
    "        embeddings = self.embedding(x)\n",
    "\n",
    "        # o contains hidden state for every timestep from last layer (B, L, hidden_dim)\n",
    "        # h contains hidden state for last timestep (num_layers, B, hidden_dim)\n",
    "        o, h = self.rnn(embeddings)\n",
    "        \n",
    "        batch_size = x.size(0)\n",
    "        actual_last_outputs = o[torch.arange(batch_size), lengths - 1]\n",
    "        \n",
    "        return self.fc(actual_last_outputs)\n",
    "\n",
    "# ── Shared training utilities ─────────────────────────────────\n",
    "def train_model(model: nn.Module, loader, optimizer: torch.optim.Optimizer, criterion, device) -> tuple[float, float]:\n",
    "    \"\"\"One training epoch. Returns (avg_loss, accuracy).\"\"\"  \n",
    "    \"\"\" Your Code \"\"\"\n",
    "    \n",
    "    model.train()\n",
    "    model.to(device)\n",
    "\n",
    "    avg_loss = 0\n",
    "    avg_acc = 0\n",
    "    n = 0\n",
    "\n",
    "    for texts, labels, lengths in loader:\n",
    "        texts, labels, lengths = texts.to(device), labels.to(device), lengths.to(device)\n",
    "        \n",
    "        y_hat = model(texts, lengths)\n",
    "\n",
    "        loss = criterion(y_hat, labels)\n",
    "        optimizer.zero_grad()\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "        _, pred = y_hat.max(axis=1) # returns max, indice of max\n",
    "        acc = (pred == labels).sum().item() / labels.size(0)\n",
    "\n",
    "        # online mean\n",
    "        n += 1\n",
    "        avg_loss = avg_loss + (loss.item() - avg_loss)/n\n",
    "        avg_acc = avg_acc + (acc - avg_acc)/n\n",
    "\n",
    "    return (avg_loss, avg_acc)\n",
    "\n",
    "def evaluate_model(model: nn.Module, loader, criterion, device):\n",
    "    \"\"\"Evaluation pass (no gradients). Returns (avg_loss, accuracy).\"\"\"\n",
    "    \n",
    "    \"\"\" Your Code \"\"\"\n",
    "    model.eval()\n",
    "    avg_loss = 0\n",
    "    avg_acc = 0\n",
    "    n = 0\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for texts, labels, lengths in loader:\n",
    "            texts, labels, lengths = texts.to(device), labels.to(device), lengths.to(device)\n",
    "            \n",
    "            y_hat = model(texts, lengths)\n",
    "\n",
    "            loss = criterion(y_hat, labels)\n",
    "\n",
    "            _, pred = y_hat.max(axis=1)\n",
    "            acc = (pred == labels).sum().item() / labels.size(0)\n",
    "\n",
    "            n += 1\n",
    "            avg_loss = avg_loss + (loss.item() - avg_loss)/n\n",
    "            avg_acc = avg_acc + (acc - avg_acc)/n\n",
    "\n",
    "    return (avg_loss, avg_acc)\n",
    "\n",
    "def run_training(m_info: ModelTrainStats, train_loader, test_loader, n_epochs=5, lr=1e-3):\n",
    "    \"\"\"Full training run. Returns history dict.\"\"\"    \n",
    "    \n",
    "    \"\"\" Your Code \"\"\"\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    optimiser = torch.optim.Adam(m_info.model.parameters(), lr=lr)\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "        \n",
    "    history = m_info.train_stats\n",
    "\n",
    "    m_info.start_timer()\n",
    "\n",
    "    for epoch in range(n_epochs):\n",
    "        print(f\"Epoch {epoch+1}/{n_epochs}\", end=\" \")\n",
    "    \n",
    "        train_loss, train_accuracy = train_model(m_info.model, train_loader, optimiser, criterion, device)\n",
    "        evaluate_loss, evaluate_accuracy = evaluate_model(m_info.model, test_loader, criterion, device)\n",
    "        \n",
    "        print(f\"Train Loss: {train_loss:.4f} | Train Acc: {train_accuracy:.4f} | Test Loss: {evaluate_loss:.4f} | Test Acc: {evaluate_accuracy:.4f}\")\n",
    "        \n",
    "        history.train_loss.append(train_loss)\n",
    "        history.train_acc.append(train_accuracy)\n",
    "        history.test_loss.append(evaluate_loss)\n",
    "        history.test_acc.append(evaluate_accuracy)\n",
    "\n",
    "    m_info.stop_timer(n_epochs)\n",
    "\n",
    "    return history"
   ]
  },
